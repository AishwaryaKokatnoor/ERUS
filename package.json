{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "postinstall": "prisma generate",
    "start": "node scripts/start.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:backend": "node test-backend.mjs",
    "test:mongo": "node scripts/test-mongo.mjs",
    "test:complexity": "tsx scripts/cyclomatic-complexity.ts",
    "seed:mongo": "tsx -e \"import { initMongoDBTablesAndSubTables } from './src/db/mongo.ts'; initMongoDBTablesAndSubTables().then(() => process.exit(0));\"",
    "verify:mongo": "tsx scripts/verify-mongo-backend.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.10.2",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.13",
    "prisma": "^6.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  }
}
